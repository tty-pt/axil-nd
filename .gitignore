*.o
*.d
*.so
/test
# mods.load is TRACKED (MODS.md §0.4): the module list is a shipped,
# source-controlled artifact, not a local scratch file. nd_mods_load() reads it
# at boot and every module repo has to appear in it, so it cannot be ignored
# or the list would differ per checkout.
/man
/htdocs
/types
/cjs
/esm
/node_modules
# NO package-lock.json. The build matrix covers 7 platforms and CI installs
# with a bare `npm install`; a lockfile would pin whichever platform's optional
# deps the generating machine resolved, breaking the other legs rather than
# helping. See CI note in CHANGELOG 1.0.0.
/package-lock.json
/sessions
/docs
/var
/.pi
/objects-set.mk
