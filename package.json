{
  "name": "@tty-pt/axil-nd",
  "version": "1.0.0",
  "description": "NeverDark MUCK engine as an axil module",
  "main": "cjs/index.js",
  "browser": "htdocs/index.js",
  "module": "esm/index.js",
  "entry": {
    "main": "./index.js"
  },
  "template": "index.html",
  "library": "ttyNd",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./types/index.d.ts",
      "default": "./cjs/index.js"
    },
    "./style.css": "./htdocs/style.css"
  },
  "external": {
    "@tty-pt/axil-tty": "global ttyAxil",
    "@tty-pt/sub": "global ttySub",
    "@popperjs/core": "global Popper",
    "@xterm/addon-fit": "global FitAddon",
    "@xterm/addon-web-links": "global WebLinksAddon",
    "@xterm/xterm": "global Terminal",
    "lodash": "global lodash"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "scripts build && tailwindcss -i src/app.css -o htdocs/app.css --minify && node tools/verify-css.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/axil-nd.git"
  },
  "author": "quirinpa",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/tty-pt/axil-nd/issues"
  },
  "homepage": "https://tty.pt",
  "devDependencies": {
    "@popperjs/core": "^2.11.0",
    "@tty-pt/axil-tty": "^1.3.2",
    "@tty-pt/scripts": "^0.8.0",
    "@tty-pt/sub": "^2.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lodash": "^4.17.21",
    "tailwindcss": "^3.4.19"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lodash": "^4.17.21"
  },
  "keywords": [
    "axil",
    "muck",
    "MUD",
    "muse",
    "NeverDark",
    "TinyMUCK",
    "FuzzBall",
    "WebSocket",
    "game"
  ],
  "serve": [
    "art"
  ],
  "files": [
    "htdocs",
    ".index",
    "cjs",
    "esm",
    "src/*.c",
    "index.js",
    "include",
    "Makefile"
  ]
}
